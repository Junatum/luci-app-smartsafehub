#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -u
umask 077

RUNTIME_DIR="${SMARTSAFEHUB_LICENSE_RUNTIME_DIR:-/tmp/smartsafehub}"
STATE_FILE="${SMARTSAFEHUB_LICENSE_STATE_FILE:-$RUNTIME_DIR/license.json}"
ACTIVATION_LOCK="${SMARTSAFEHUB_LICENSE_ACTIVATION_LOCK:-$RUNTIME_DIR/license-activate.lock}"
ACTIVATION_REQUEST_PATH="${SMARTSAFEHUB_LICENSE_ACTIVATION_REQUEST_FILE:-$RUNTIME_DIR/license-activate.request.json}"
UCI_BIN="${SMARTSAFEHUB_LICENSE_UCI_BIN:-uci}"
UBUS_BIN="${SMARTSAFEHUB_LICENSE_UBUS_BIN:-ubus}"
JSONFILTER_BIN="${SMARTSAFEHUB_LICENSE_JSONFILTER_BIN:-jsonfilter}"
UCLIENT_FETCH_BIN="${SMARTSAFEHUB_LICENSE_UCLIENT_FETCH_BIN:-uclient-fetch}"
DATE_BIN="${SMARTSAFEHUB_LICENSE_DATE_BIN:-date}"
LOGGER_BIN="${SMARTSAFEHUB_LICENSE_LOGGER_BIN:-logger}"
SLEEP_BIN="${SMARTSAFEHUB_LICENSE_SLEEP_BIN:-sleep}"
DEFAULT_API_BASE_URL="https://www.smartsafehub.com/api/v1"
DEFAULT_CHECK_INTERVAL_S=300
DEFAULT_STARTUP_DELAY_S=30
MIN_CHECK_INTERVAL_S=60
REQUEST_TIMEOUT_S=10
ACTIVATION_STALE_S=60

ACTIVATION_REQUEST_FILE=''
ACTIVATION_KEY=''
ACTIVATION_BODY_FILE=''
ACTIVATION_RESPONSE_FILE=''
STATUS_REQUEST_FILE=''
STATUS_RESPONSE_FILE=''
SAFESHIELD_STATUS_FILE=''
LICENSE_FILE=''

cleanup_files() {
	[ -n "$ACTIVATION_BODY_FILE" ] && rm -f "$ACTIVATION_BODY_FILE"
	[ -n "$ACTIVATION_RESPONSE_FILE" ] && rm -f "$ACTIVATION_RESPONSE_FILE"
	[ -n "$STATUS_REQUEST_FILE" ] && rm -f "$STATUS_REQUEST_FILE"
	[ -n "$STATUS_RESPONSE_FILE" ] && rm -f "$STATUS_RESPONSE_FILE"
	[ -n "$SAFESHIELD_STATUS_FILE" ] && rm -f "$SAFESHIELD_STATUS_FILE"
	[ -n "$LICENSE_FILE" ] && rm -f "$LICENSE_FILE"
}
trap cleanup_files EXIT INT TERM

log_message() {
	"$LOGGER_BIN" -t smartsafehub-license -- "$*" 2>/dev/null || true
}

uci_get() {
	"$UCI_BIN" -q get "smartsafehub.license.$1" 2>/dev/null || true
}

normalized_integer() {
	local value="$1" fallback="$2" minimum="$3"
	case "$value" in
		''|*[!0-9]*) value="$fallback" ;;
	esac
	[ "$value" -ge "$minimum" ] 2>/dev/null || value="$fallback"
	printf '%s' "$value"
}

check_interval_s() {
	normalized_integer "$(uci_get check_interval_s)" "$DEFAULT_CHECK_INTERVAL_S" "$MIN_CHECK_INTERVAL_S"
}

startup_delay_s() {
	normalized_integer "$(uci_get startup_delay_s)" "$DEFAULT_STARTUP_DELAY_S" 0
}

api_base_url() {
	local value
	value="$(uci_get api_base_url)"
	case "$value" in
		https://*) printf '%s' "${value%/}" ;;
		*) printf '%s' "$DEFAULT_API_BASE_URL" ;;
	esac
}

now_epoch() {
	local value
	value="$("$DATE_BIN" +%s 2>/dev/null || true)"
	case "$value" in
		''|*[!0-9]*) value=0 ;;
	esac
	printf '%s' "$value"
}

json_escape() {
	printf '%s' "$1" | sed \
		-e 's/\\/\\\\/g' \
		-e 's/"/\\"/g' \
		-e 's/\r/ /g' \
		-e 's/\n/ /g'
}

json_string_or_null() {
	if [ -n "$1" ]; then
		printf '"%s"' "$(json_escape "$1")"
	else
		printf 'null'
	fi
}

json_value() {
	local file="$1" expression="$2"
	[ -f "$file" ] || return 0
	"$JSONFILTER_BIN" -i "$file" -e "$expression" 2>/dev/null || true
}

sanitize_code() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9_.:-' | cut -c 1-120
}

write_state() {
	local phase="$1" result="$2" error="$3" last_attempt_at="$4" last_checked_at="$5"
	local last_activated_at="$6" next_check_at="$7" plan="$8" license_status="$9"
	shift 9
	local activation_status="$1" device_action="$2" tmp

	mkdir -p "$RUNTIME_DIR" || return 1
	tmp="${STATE_FILE}.tmp.$$"
	cat > "$tmp" <<EOF_STATE
{"schema":1,"component":"license","phase":"$(json_escape "$phase")","lastResult":"$(json_escape "$result")","lastErrorCode":$(json_string_or_null "$(sanitize_code "$error")"),"lastAttemptAt":$last_attempt_at,"lastCheckedAt":$last_checked_at,"lastActivatedAt":$last_activated_at,"nextCheckAt":$next_check_at,"plan":$(json_string_or_null "$(sanitize_code "$plan")"),"licenseStatus":$(json_string_or_null "$(sanitize_code "$license_status")"),"activationStatus":$(json_string_or_null "$(sanitize_code "$activation_status")"),"deviceAction":$(json_string_or_null "$(sanitize_code "$device_action")")}
EOF_STATE
	mv "$tmp" "$STATE_FILE"
}

read_previous_number() {
	local expression="$1" value
	value="$(json_value "$STATE_FILE" "$expression")"
	case "$value" in
		''|*[!0-9]*) value=0 ;;
	esac
	printf '%s' "$value"
}

read_license_key() {
	local configured key
	LICENSE_FILE="$RUNTIME_DIR/license-local.$$.json"
	if ! "$UBUS_BIN" call safeshield license_get > "$LICENSE_FILE" 2>/dev/null; then
		return 1
	fi
	configured="$(json_value "$LICENSE_FILE" '@.license.configured')"
	key="$(json_value "$LICENSE_FILE" '@.license.key')"
	[ -n "$key" ] || key="$(json_value "$LICENSE_FILE" '@.key')"
	case "$configured" in
		true|1) ;;
		*) printf '%s' ''; return 0 ;;
	esac
	printf '%s' "$key"
}

read_physical_fingerprint() {
	local fingerprint
	SAFESHIELD_STATUS_FILE="$RUNTIME_DIR/license-safeshield.$$.json"
	if ! "$UBUS_BIN" call safeshield status > "$SAFESHIELD_STATUS_FILE" 2>/dev/null; then
		return 1
	fi
	fingerprint="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.physical_fingerprint')"
	case "$fingerprint" in
		????????????????????????????????????????????????????????????????)
			case "$fingerprint" in *[!0-9a-fA-F]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
	printf '%s' "$fingerprint"
}

build_activation_body() {
	local request_file="$1" key fingerprint fingerprint_version identity_provider identity_source
	local identity_strength identity_profile installation_id vendor model arch memory_mb version memory_json

	key="$(json_value "$request_file" '@.license_key')"
	[ -n "$key" ] || return 12

	SAFESHIELD_STATUS_FILE="$RUNTIME_DIR/license-safeshield.$$.json"
	if ! "$UBUS_BIN" call safeshield status > "$SAFESHIELD_STATUS_FILE" 2>/dev/null; then
		return 10
	fi

	fingerprint="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.physical_fingerprint')"
	case "$fingerprint" in
		????????????????????????????????????????????????????????????????)
			case "$fingerprint" in *[!0-9a-fA-F]*) return 10 ;; esac
			;;
		*) return 10 ;;
	esac

	fingerprint_version="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.fingerprint_version')"
	case "$fingerprint_version" in
		''|*[!0-9]*) fingerprint_version=1 ;;
	esac
	[ "$fingerprint_version" -ge 1 ] 2>/dev/null || fingerprint_version=1

	identity_provider="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.identity_provider')"
	identity_source="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.identity_source')"
	identity_strength="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.identity_strength')"
	identity_profile="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.identity_profile')"
	installation_id="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.installation_id')"
	vendor="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.configured.vendor')"
	model="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.configured.model')"
	arch="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.configured.arch')"
	memory_mb="$(json_value "$SAFESHIELD_STATUS_FILE" '@.device.configured.memory_mb')"
	version="$(json_value "$SAFESHIELD_STATUS_FILE" '@.version')"

	[ -n "$vendor" ] && [ -n "$model" ] && [ -n "$arch" ] && [ -n "$version" ] || return 11
	case "$memory_mb" in
		''|*[!0-9]*) memory_json='null' ;;
		*)
			if [ "$memory_mb" -gt 0 ] 2>/dev/null; then
				memory_json="$memory_mb"
			else
				memory_json='null'
			fi
			;;
	esac

	ACTIVATION_BODY_FILE="$RUNTIME_DIR/license-activate-body.$$.json"
	cat > "$ACTIVATION_BODY_FILE" <<EOF_ACTIVATION_BODY
{"license_key":"$(json_escape "$key")","device":{"physical_fingerprint":"$(json_escape "$fingerprint")","fingerprint_version":$fingerprint_version,"identity_provider":"$(json_escape "$identity_provider")","identity_source":"$(json_escape "$identity_source")","identity_strength":"$(json_escape "$identity_strength")","identity_profile":"$(json_escape "$identity_profile")","installation_id":$(json_string_or_null "$installation_id"),"vendor":"$(json_escape "$vendor")","model":"$(json_escape "$model")","arch":"$(json_escape "$arch")","memory_mb":$memory_json,"safeshield_version":"$(json_escape "$version")"}}
EOF_ACTIVATION_BODY
	ACTIVATION_KEY="$key"
	return 0
}

post_json() {
	local body_file="$1" output_file="$2" url="$3"
	"$UCLIENT_FETCH_BIN" -q -T "$REQUEST_TIMEOUT_S" \
		--method=POST \
		--body-file="$body_file" \
		--header='Content-Type: application/json' \
		-O "$output_file" \
		"$url"
}

server_error_code() {
	local file="$1" code
	code="$(json_value "$file" '@.code')"
	[ -n "$code" ] || code="$(json_value "$file" '@.error.code')"
	printf '%s' "$(sanitize_code "$code")"
}

update_local_license() {
	local key="$1" payload
	payload="{\"license_key\":\"$(json_escape "$key")\"}"
	"$UBUS_BIN" call safeshield license_update "$payload" >/dev/null 2>&1
}

activation_cleanup() {
	[ -n "$ACTIVATION_REQUEST_FILE" ] && rm -f "$ACTIVATION_REQUEST_FILE"
	rmdir "$ACTIVATION_LOCK" 2>/dev/null || true
}

activation_in_progress() {
	local now phase started age
	[ -d "$ACTIVATION_LOCK" ] || return 1

	now="$(now_epoch)"
	phase="$(json_value "$STATE_FILE" '@.phase')"
	started="$(read_previous_number '@.lastAttemptAt')"
	if [ "$phase" = 'activating' ] && [ "$started" -gt 0 ] 2>/dev/null && [ "$now" -ge "$started" ] 2>/dev/null; then
		age=$((now - started))
		[ "$age" -lt "$ACTIVATION_STALE_S" ] && return 0
	fi

	# A detached activation helper can be killed independently of the daemon.
	# Recover an abandoned lock so periodic status checks and later activations
	# are not blocked until the next reboot.
	rm -f "$ACTIVATION_REQUEST_PATH" 2>/dev/null || true
	rmdir "$ACTIVATION_LOCK" 2>/dev/null || true
	if [ -d "$ACTIVATION_LOCK" ]; then
		return 0
	fi
	log_message 'LICENSE_ACTIVATION_STALE: 중단된 라이선스 활성화 lock을 정리했습니다.'
	return 1
}

activate_license() {
	local request_file='' now previous_checked previous_activated base key build_rc licensed activation_status plan license_status error_code interval

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--request-file)
				[ "$#" -ge 2 ] || return 2
				request_file="$2"
				shift 2
				;;
			*) return 2 ;;
		esac
	done
	[ -n "$request_file" ] && [ -f "$request_file" ] || return 2
	ACTIVATION_REQUEST_FILE="$request_file"
	ACTIVATION_RESPONSE_FILE="$RUNTIME_DIR/license-activate-response.$$.json"
	now="$(now_epoch)"
	previous_checked="$(read_previous_number '@.lastCheckedAt')"
	previous_activated="$(read_previous_number '@.lastActivatedAt')"
	write_state activating activating '' "$now" "$previous_checked" "$previous_activated" 0 '' '' '' none

	build_rc=0
	build_activation_body "$request_file" || build_rc=$?
	if [ "$build_rc" -ne 0 ]; then
		case "$build_rc" in
			10) error_code='LICENSE_DEVICE_IDENTITY_UNAVAILABLE' ;;
			11) error_code='LICENSE_DEVICE_PROFILE_UNAVAILABLE' ;;
			*) error_code='LICENSE_KEY_INVALID' ;;
		esac
		write_state error failed "$error_code" "$now" "$previous_checked" "$previous_activated" 0 '' '' '' none
		log_message "$error_code: 라이선스 등록 요청에 필요한 장치 정보를 준비하지 못했습니다."
		activation_cleanup
		return 1
	fi
	key="$ACTIVATION_KEY"

	base="$(api_base_url)"
	if ! post_json "$ACTIVATION_BODY_FILE" "$ACTIVATION_RESPONSE_FILE" "$base/licenses/activate"; then
		error_code="$(server_error_code "$ACTIVATION_RESPONSE_FILE")"
		[ -n "$error_code" ] || error_code='LICENSE_ACTIVATE_HTTP_FAILED'
		write_state error failed "$error_code" "$now" "$previous_checked" "$previous_activated" 0 '' '' '' none
		log_message "$error_code: 라이선스 활성화 요청에 실패했습니다."
		activation_cleanup
		return 1
	fi

	licensed="$(json_value "$ACTIVATION_RESPONSE_FILE" '@.license.is_licensed')"
	activation_status="$(json_value "$ACTIVATION_RESPONSE_FILE" '@.activation.status')"
	plan="$(json_value "$ACTIVATION_RESPONSE_FILE" '@.license.plan')"
	license_status="$(json_value "$ACTIVATION_RESPONSE_FILE" '@.license.status')"
	if [ "$licensed" != 'true' ] && [ "$licensed" != '1' ]; then
		write_state error failed LICENSE_ACTIVATE_RESPONSE_INVALID "$now" "$previous_checked" "$previous_activated" 0 "$plan" "$license_status" "$activation_status" none
		log_message 'LICENSE_ACTIVATE_RESPONSE_INVALID: 활성화 응답이 유효하지 않습니다.'
		activation_cleanup
		return 1
	fi
	if [ "$activation_status" != 'active' ]; then
		write_state error failed LICENSE_ACTIVATE_RESPONSE_INVALID "$now" "$previous_checked" "$previous_activated" 0 "$plan" "$license_status" "$activation_status" none
		log_message 'LICENSE_ACTIVATE_RESPONSE_INVALID: activation 상태가 active가 아닙니다.'
		activation_cleanup
		return 1
	fi

	if [ -z "$key" ] || ! update_local_license "$key"; then
		write_state error failed LICENSE_LOCAL_UPDATE_FAILED "$now" "$previous_checked" "$previous_activated" 0 "$plan" "$license_status" "$activation_status" none
		log_message 'LICENSE_LOCAL_UPDATE_FAILED: SafeShield에 라이선스 키를 저장하지 못했습니다.'
		activation_cleanup
		return 1
	fi

	now="$(now_epoch)"
	interval="$(check_interval_s)"
	write_state active activated '' "$now" "$now" "$now" $((now + interval)) "$plan" "$license_status" "$activation_status" none
	log_message '라이선스 활성화와 로컬 적용을 완료했습니다.'
	activation_cleanup
	return 0
}

status_sync() {
	local now previous_activated interval next_check key fingerprint base action licensed plan license_status activation_status

	# Activation and periodic reconciliation share one state file. Do not let a
	# scheduled status check overwrite an in-flight explicit activation result.
	activation_in_progress && return 0

	now="$(now_epoch)"
	previous_activated="$(read_previous_number '@.lastActivatedAt')"
	interval="$(check_interval_s)"
	next_check=$((now + interval))

	if ! key="$(read_license_key 2>/dev/null)"; then
		write_state error failed LICENSE_LOCAL_READ_FAILED "$now" "$now" "$previous_activated" "$next_check" '' '' '' none
		log_message 'LICENSE_LOCAL_READ_FAILED: SafeShield 라이선스 상태를 읽지 못했습니다.'
		return 1
	fi
	if [ -z "$key" ]; then
		write_state unconfigured unconfigured '' "$now" "$now" "$previous_activated" "$next_check" '' unlicensed not_found none
		return 0
	fi

	fingerprint="$(read_physical_fingerprint 2>/dev/null || true)"
	if [ -z "$fingerprint" ]; then
		write_state error failed LICENSE_DEVICE_IDENTITY_UNAVAILABLE "$now" "$now" "$previous_activated" "$next_check" '' '' '' none
		log_message 'LICENSE_DEVICE_IDENTITY_UNAVAILABLE: SafeShield 장치 식별 정보를 읽지 못했습니다.'
		return 1
	fi

	STATUS_REQUEST_FILE="$RUNTIME_DIR/license-status-request.$$.json"
	STATUS_RESPONSE_FILE="$RUNTIME_DIR/license-status-response.$$.json"
	cat > "$STATUS_REQUEST_FILE" <<EOF_REQUEST
{"license_key":"$(json_escape "$key")","device":{"physical_fingerprint":"$(json_escape "$fingerprint")"}}
EOF_REQUEST

	write_state checking checking '' "$now" "$now" "$previous_activated" "$next_check" '' '' '' none
	base="$(api_base_url)"
	if ! post_json "$STATUS_REQUEST_FILE" "$STATUS_RESPONSE_FILE" "$base/licenses/status"; then
		write_state error failed LICENSE_STATUS_HTTP_FAILED "$now" "$now" "$previous_activated" "$next_check" '' '' '' none
		log_message 'LICENSE_STATUS_HTTP_FAILED: 라이선스 상태를 확인하지 못했습니다.'
		return 1
	fi

	action="$(json_value "$STATUS_RESPONSE_FILE" '@.device_action')"
	licensed="$(json_value "$STATUS_RESPONSE_FILE" '@.license.is_licensed')"
	plan="$(json_value "$STATUS_RESPONSE_FILE" '@.license.plan')"
	license_status="$(json_value "$STATUS_RESPONSE_FILE" '@.license.status')"
	activation_status="$(json_value "$STATUS_RESPONSE_FILE" '@.activation.status')"

	if [ "$action" = 'none' ] && { [ "$licensed" = 'true' ] || [ "$licensed" = '1' ]; }; then
		write_state active active '' "$now" "$now" "$previous_activated" "$next_check" "$plan" "$license_status" "$activation_status" none
		return 0
	fi

	if [ "$action" = 'clear_license' ]; then
		if ! update_local_license ''; then
			write_state error failed LICENSE_LOCAL_CLEAR_FAILED "$now" "$now" "$previous_activated" "$next_check" "$plan" "$license_status" "$activation_status" clear_license
			log_message 'LICENSE_LOCAL_CLEAR_FAILED: 서버 해제 지시를 로컬에 적용하지 못했습니다.'
			return 1
		fi
		write_state cleared cleared '' "$now" "$now" "$previous_activated" "$next_check" "$plan" "$license_status" "$activation_status" clear_license
		log_message "서버 라이선스 상태($activation_status)에 따라 로컬 라이선스를 제거했습니다."
		return 0
	fi

	write_state error failed LICENSE_STATUS_RESPONSE_INVALID "$now" "$now" "$previous_activated" "$next_check" "$plan" "$license_status" "$activation_status" "$action"
	log_message 'LICENSE_STATUS_RESPONSE_INVALID: 상태 API 응답 계약이 올바르지 않습니다.'
	return 1
}

show_status() {
	if [ -s "$STATE_FILE" ]; then
		cat "$STATE_FILE"
	else
		printf '%s\n' '{"schema":1,"component":"license","phase":"unknown","lastResult":"never","lastErrorCode":null,"lastAttemptAt":0,"lastCheckedAt":0,"lastActivatedAt":0,"nextCheckAt":0,"plan":null,"licenseStatus":null,"activationStatus":null,"deviceAction":null}'
	fi
}

daemon_loop() {
	local delay interval
	delay="$(startup_delay_s)"
	[ "$delay" -eq 0 ] || "$SLEEP_BIN" "$delay"
	while true; do
		status_sync || true
		interval="$(check_interval_s)"
		"$SLEEP_BIN" "$interval"
	done
}

usage() {
	cat <<'EOF_USAGE'
Usage: smartsafehub-license <command>

Commands:
  daemon                         Run periodic license status synchronization.
  activate --request-file PATH   Activate a license using a prepared Hub request.
  status-sync                    Check Hub license status once and reconcile locally.
  status                         Print the current local license-agent state.
EOF_USAGE
}

mkdir -p "$RUNTIME_DIR" || exit 1

case "${1:-}" in
	daemon)
		shift
		daemon_loop "$@"
		;;
	activate)
		shift
		activate_license "$@"
		;;
	status-sync)
		shift
		status_sync "$@"
		;;
	status)
		shift
		show_status "$@"
		;;
	*)
		usage >&2
		exit 2
		;;
esac
