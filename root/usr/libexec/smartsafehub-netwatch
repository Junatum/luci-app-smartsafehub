#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# SmartSafeHub Network Watch: lightweight, read-only connection observations.
set -u
umask 077
COMMON_LIB="${SMARTSAFEHUB_NETWATCH_COMMON_LIB:-$(dirname "$0")/../lib/smartsafehub/common.sh}"
[ -r "$COMMON_LIB" ] || { echo 'Network Watch common library unavailable' >&2; exit 1; }
. "$COMMON_LIB"

RUNTIME="${SMARTSAFEHUB_NETWATCH_RUNTIME_DIR:-/tmp/smartsafehub/netwatch}"
PROC="${SMARTSAFEHUB_NETWATCH_PROC:-/proc/net/nf_conntrack}"
PARSER="${SMARTSAFEHUB_NETWATCH_PARSER:-/usr/lib/smartsafehub/netwatch.awk}"
LEARNER="${SMARTSAFEHUB_NETWATCH_LEARNER:-/usr/lib/smartsafehub/netwatch-learn.awk}"
ARP="${SMARTSAFEHUB_NETWATCH_ARP:-/proc/net/arp}"
PERSIST="${SMARTSAFEHUB_NETWATCH_PERSIST_DIR:-/etc/smartsafehub/netwatch}"
EVENTS="${SMARTSAFEHUB_NETWATCH_EVENTS:-/usr/libexec/smartsafehub-events}"
UCI="${SMARTSAFEHUB_NETWATCH_UCI:-uci}"
DATE="${SMARTSAFEHUB_NETWATCH_DATE:-date}"
CONNTRACK="${SMARTSAFEHUB_NETWATCH_CONNTRACK:-conntrack}"
AWK="${SMARTSAFEHUB_NETWATCH_AWK:-awk}"
STATUS="$RUNTIME/status.json"
SNAPSHOT="$RUNTIME/previous.tsv"
STAMPS="$RUNTIME/alerts.tsv"
HISTORY="$RUNTIME/history.tsv"
STREAK="$RUNTIME/streak.tsv"
SYNC_AT="$RUNTIME/sync.at"
# The previous revision used sample.lock as a symlink, potentially with a
# stranded sample.lock.reclaim guard. Start a fresh shared-helper mutex name.
LOCK="$RUNTIME/sample.lock.d"
LEGACY_LOCK="$RUNTIME/sample.lock"

cleanup() {
    rm -f "$RUNTIME"/*.tmp."$$"
    ssh_lock_release "$LOCK"
}

# Kill -9 skips traps. Reclaim only known temporary files whose PID is gone.
# A small per-sample bound keeps directory cleanup predictable on tiny routers.
cleanup_orphan_temps() {
    local file pid seen=0
    for file in "$RUNTIME"/status.tmp.* "$RUNTIME"/previous.tmp.* \
        "$RUNTIME"/candidate.tmp.* "$RUNTIME"/conntrack.tmp.* \
        "$RUNTIME"/conntrack-rc.tmp.* "$RUNTIME"/conntrack-pid.tmp.* \
        "$RUNTIME"/alerts.tmp.* "$RUNTIME"/metadata.tmp.* "$RUNTIME"/history.tmp.* \
        "$RUNTIME"/streak.tmp.* "$RUNTIME"/recovered.tmp.* "$RUNTIME"/filter.tmp.*; do
        [ -f "$file" ] || continue
        pid="${file##*.}"
        case "$pid" in ''|0*|*[!0-9]*) continue ;; esac
        [ "$pid" = "$$" ] && continue
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$file" 2>/dev/null || true
        fi
        seen=$((seen + 1))
        [ "$seen" -lt 64 ] || break
    done
}

# Respect an in-flight sampler from an earlier release during an upgrade;
# leave old-style stale locks out of the new shared lock namespace.
legacy_sampler_running() {
    local owner
    [ -L "$LEGACY_LOCK" ] || return 1
    owner="$(readlink "$LEGACY_LOCK" 2>/dev/null || true)"
    case "$owner" in ''|0*|*[!0-9]*) return 1 ;; esac
    kill -0 "$owner" 2>/dev/null
}

write_status() {
    [ "$1" = 'unavailable' ] && rm -f "$SNAPSHOT"
    printf '{"schema":1,"phase":"%s","sampledAt":0,"intervalSeconds":60,"source":"conntrack","ipv4Only":true,"limited":false,"totalConnections":0,"totalDevices":0,"devices":[],"alert":null}\n' "$1" > "$RUNTIME/status.tmp.$$" &&
        mv -f "$RUNTIME/status.tmp.$$" "$STATUS"
}

# Restore limited state without copying unbounded or malformed files from flash.
restore_history() {
    if [ ! -e "$HISTORY" ]; then
        if [ -r "$PERSIST/baseline.tsv" ] &&
            [ "$(wc -c < "$PERSIST/baseline.tsv")" -le 196608 ] &&
            [ "$(wc -l < "$PERSIST/baseline.tsv")" -le 896 ]; then
            cp "$PERSIST/baseline.tsv" "$HISTORY" 2>/dev/null || : > "$HISTORY"
        else
            : > "$HISTORY"
        fi
    fi
    if [ ! -e "$STAMPS" ]; then
        if [ -r "$PERSIST/active.tsv" ] &&
            [ "$(wc -c < "$PERSIST/active.tsv")" -le 2048 ]; then
            cp "$PERSIST/active.tsv" "$STAMPS" 2>/dev/null || : > "$STAMPS"
        else
            : > "$STAMPS"
        fi
    fi
}

# Flash writes are limited to a six-hour cadence; RAM holds 15-minute buckets
# between checkpoints. A lost checkpoint must not interrupt observations.
checkpoint_history() {
    local now="$1" previous=0 bytes
    [ -r "$SYNC_AT" ] && previous="$(cat "$SYNC_AT" 2>/dev/null || echo 0)"
    case "$previous" in ''|*[!0-9]*) previous=0 ;; esac
    [ "$now" -ge "$previous" ] && [ "$((now-previous))" -lt 21600 ] && return 0
    bytes="$(wc -c < "$HISTORY")"
    [ "$bytes" -le 196608 ] || return 0
    mkdir -p "$PERSIST" 2>/dev/null || return 0
    if cp "$HISTORY" "$PERSIST/baseline.tmp.$$" 2>/dev/null &&
        mv -f "$PERSIST/baseline.tmp.$$" "$PERSIST/baseline.tsv" 2>/dev/null; then
        printf '%s\n' "$now" > "$SYNC_AT"
    fi
    rm -f "$PERSIST/baseline.tmp.$$" 2>/dev/null || true
}

# A warning is one episode per identity: never repeat while it remains abnormal.
# Re-arm only after three complete normal/absent observations. Do not consume an
# alert when event emission fails. Persist only on episode transitions.
alert_if_due() {
    local candidates="$1" recovered="$2" tmp="$RUNTIME/alerts.tmp.$$"
    local id ip connections destinations baseline_connections baseline_destinations changed=0
    if [ -r "$STAMPS" ]; then
        "$AWK" 'FILENAME == ARGV[1] {resolved[$1]=1; next}             ($1 ~ /^[im]:/ && !($1 in resolved)) {print $1}'             "$recovered" "$STAMPS" > "$tmp" || return 1
        cmp -s "$tmp" "$STAMPS" || changed=1
    else
        : > "$tmp" || return 1
    fi
    while IFS="$(printf '\t')" read -r id ip connections destinations baseline_connections baseline_destinations; do
        case "$id" in m:*|i:*) ;; *) continue ;; esac
        case "$ip" in ''|*[!0-9.]*) continue ;; esac
        case "$connections:$destinations:$baseline_connections:$baseline_destinations" in
            *[!0-9:]*|:*) continue ;;
        esac
        if grep -Fqx "$id" "$tmp" 2>/dev/null; then continue; fi
        if "$EVENTS" emit-quiet network_watch network_watch.anomaly.warning warning             "{\"source_ip\":\"$ip\",\"connections\":$connections,\"destinations\":$destinations,\"baseline_connections\":$baseline_connections,\"baseline_destinations\":$baseline_destinations}" >/dev/null 2>&1; then
            printf '%s\n' "$id" >> "$tmp"
            changed=1
        fi
        break
    done < "$candidates"
    mv -f "$tmp" "$STAMPS" || return 1
    if [ "$changed" -eq 1 ] && mkdir -p "$PERSIST" 2>/dev/null; then
        cp "$STAMPS" "$PERSIST/active.tmp.$$" 2>/dev/null &&
            mv -f "$PERSIST/active.tmp.$$" "$PERSIST/active.tsv" 2>/dev/null || true
        rm -f "$PERSIST/active.tmp.$$" 2>/dev/null || true
    fi
}

# Stream at most 2049 lines to tmpfs. A shell-script producer may ignore a
# failed printf after SIGPIPE and keep generating records even after head exits.
# Explicitly terminate the producer at the cap rather than trusting SIGPIPE.
# The producer's exit status remains available for short/failed snapshots.
read_conntrack_bounded() {
    local output="$1" result="$2" pidfile="$3" rc lines producer_pid
    (
        "$CONNTRACK" -L -f ipv4 2>/dev/null &
        producer_pid=$!
        printf '%s\n' "$producer_pid" > "$pidfile" || exit 1
        # The watchdog must not retain the producer's stdout pipe: a live
        # sleep child would otherwise delay EOF on a successful short read.
        (
            sleep 5
            kill -TERM "$producer_pid" 2>/dev/null || true
            sleep 1
            kill -KILL "$producer_pid" 2>/dev/null || true
        ) >/dev/null 2>&1 &
        watchdog_pid=$!
        wait "$producer_pid" 2>/dev/null
        producer_rc=$?
        kill "$watchdog_pid" 2>/dev/null || true
        wait "$watchdog_pid" 2>/dev/null || true
        printf '%s\n' "$producer_rc" > "$result"
    ) | (
        head -n 2049 > "$output" || exit 1
        lines="$(wc -l < "$output")"
        if [ "$lines" -ge 2049 ]; then
            producer_pid="$(cat "$pidfile" 2>/dev/null || true)"
            case "$producer_pid" in
                ''|0*|*[!0-9]*) return 1 ;;
            esac
            kill -TERM "$producer_pid" 2>/dev/null || true
        fi
    ) || return 1
    rc="$(cat "$result" 2>/dev/null || true)"
    lines="$(wc -l < "$output")"
    if [ "$lines" -ge 2049 ]; then
        # A truncated sample is never used as a baseline or to raise alerts.
        # Producer may exit due to SIGPIPE, SIGTERM, or the natural last line.
        return 0
    fi
    [ "$rc" = 0 ]
}

sample() {
    local enabled now source tmp_status tmp_snapshot tmp_candidate raw_tmp rc_tmp pid_tmp
    local tmp_meta tmp_history tmp_streak tmp_recovered limited total devices
    mkdir -p "$RUNTIME" || return 1
    legacy_sampler_running && return 0
    ssh_lock_acquire "$LOCK" 3 0.05 sleep 1 || return 0
    trap 'cleanup' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    cleanup_orphan_temps
    # Retire obsolete tmpfs state from the symlink/flock-based revisions.
    rm -f "$LEGACY_LOCK" "$RUNTIME/alert.stamp" 2>/dev/null || true
    rmdir "$RUNTIME/sample.lock.reclaim" 2>/dev/null || true
    enabled="$("$UCI" -q get smartsafehub.netwatch.enabled 2>/dev/null || true)"
    if [ "$enabled" = '0' ]; then
        rm -f "$SNAPSHOT" "$STAMPS" "$HISTORY" "$STREAK" "$SYNC_AT"
        rm -f "$PERSIST/baseline.tsv" "$PERSIST/active.tsv" 2>/dev/null || true
        write_status disabled
        return 0
    fi
    now="$("$DATE" +%s 2>/dev/null || true)"
    case "$now" in ''|*[!0-9]*) write_status unavailable; return 0 ;; esac
    tmp_status="$RUNTIME/status.tmp.$$"
    tmp_snapshot="$RUNTIME/previous.tmp.$$"
    tmp_candidate="$RUNTIME/candidate.tmp.$$"
    tmp_meta="$RUNTIME/metadata.tmp.$$"
    tmp_history="$RUNTIME/history.tmp.$$"
    tmp_streak="$RUNTIME/streak.tmp.$$"
    tmp_recovered="$RUNTIME/recovered.tmp.$$"
    raw_tmp="$RUNTIME/conntrack.tmp.$$"
    rc_tmp="$RUNTIME/conntrack-rc.tmp.$$"
    pid_tmp="$RUNTIME/conntrack-pid.tmp.$$"
    : > "$tmp_candidate" || return 1
    : > "$tmp_recovered" || return 1
    : > "$tmp_history" || return 1
    : > "$tmp_streak" || return 1
    if [ -r "$PROC" ]; then
        source="$PROC"
    else
        # Bounded producer/consumer pipeline, not an unbounded conntrack -L
        # output file. Cap tmpfs and refuse failed/partial failed reads.
        if ! (ulimit -f 1024 2>/dev/null || true; read_conntrack_bounded "$raw_tmp" "$rc_tmp" "$pid_tmp"); then
            write_status unavailable
            return 0
        fi
        source="$raw_tmp"
    fi
    if ! "$AWK" -v snapshot="$tmp_snapshot" -v metadata="$tmp_meta" \
        -v candidate="$tmp_candidate" -v status="$tmp_status" -v now="$now" \
        -f "$PARSER" "$source"; then
        write_status unavailable
        return 0
    fi
    [ -s "$tmp_status" ] && [ -s "$tmp_meta" ] || { write_status unavailable; return 0; }
    IFS="$(printf '\t')" read -r total devices limited < "$tmp_meta"
    if [ "$limited" = 0 ]; then
        restore_history
        if ! "$AWK" -v now="$now" -v arp="$ARP" \
            -v history="$HISTORY" -v streak="$STREAK" -v metadata="$tmp_meta" \
            -v new_history="$tmp_history" -v new_streak="$tmp_streak" \
            -v candidate="$tmp_candidate" -v recovered="$tmp_recovered" \
            -v status="$tmp_status" -f "$LEARNER" "$tmp_snapshot"; then
            write_status unavailable
            return 0
        fi
        mv -f "$tmp_history" "$HISTORY" || return 1
        mv -f "$tmp_streak" "$STREAK" || return 1
    fi
    mv -f "$tmp_snapshot" "$SNAPSHOT" || return 1
    mv -f "$tmp_status" "$STATUS" || return 1
    if [ "$limited" = 0 ]; then
        alert_if_due "$tmp_candidate" "$tmp_recovered"
        checkpoint_history "$now"
    fi
}

case "${1:-}" in
    sample) sample ;;
    *) echo 'Usage: smartsafehub-netwatch sample' >&2; exit 2 ;;
esac
