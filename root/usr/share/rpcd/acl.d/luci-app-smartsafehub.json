{
  "luci-app-smartsafehub": {
    "description": "Grant access to the SmartSafeHub device application",
    "read": {
      "ubus": {
        "smartsafehub": [
          "status",
          "connected_devices",
          "wifi_summary",
          "updates_status"
        ],
        "safeshield": [
          "status",
          "statistics",
          "config",
          "rules_list"
        ]
      }
    },
    "write": {
      "ubus": {
        "smartsafehub": [
          "wifi_update",
          "system_reboot",
          "updates_check",
          "updates_install",
          "updates_settings_update"
        ],
        "safeshield": [
          "set_enabled",
          "refresh",
          "rule_add",
          "rule_delete",
          "license_get",
          "license_update"
        ]
      }
    }
  }
}
