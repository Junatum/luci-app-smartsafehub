{
  "luci-app-smartsafehub": {
    "description": "Grant access to the SmartSafeHub device application",
    "read": {
      "ubus": {
        "smartsafehub": [
          "status",
          "connected_devices",
          "wifi_summary",
          "updates_status",
          "firmware_status",
          "system_time_settings"
        ],
        "safeshield": [
          "status",
          "statistics",
          "config",
          "rules_list"
        ]
      }
    },
    "write": {
      "ubus": {
        "smartsafehub": [
          "wifi_update",
          "system_timezone_update",
          "system_time_sync",
          "system_reboot",
          "updates_check",
          "updates_install",
          "updates_settings_update",
          "firmware_check",
          "firmware_prepare",
          "firmware_validate_upload",
          "firmware_install",
          "firmware_discard"
        ],
        "safeshield": [
          "set_enabled",
          "config_update",
          "refresh",
          "rule_add",
          "rule_delete",
          "license_get",
          "license_update"
        ]
      },
      "cgi-io": [
        "upload"
      ],
      "file": {
        "/tmp/smartsafehub-firmware.bin": [
          "write"
        ]
      }
    }
  }
}
