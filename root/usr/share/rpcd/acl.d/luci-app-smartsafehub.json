{
  "luci-app-smartsafehub": {
    "description": "Grant access to the SmartSafeHub device application",
    "read": {
      "ubus": {
        "smartsafehub": [
          "status",
          "connected_devices",
          "wifi_summary"
        ],
        "safeshield": [
          "status",
          "config",
          "rules_list"
        ]
      }
    },
    "write": {
      "ubus": {
        "smartsafehub": [
          "wifi_update",
          "system_reboot"
        ],
        "safeshield": [
          "config_update",
          "set_enabled",
          "refresh",
          "rule_add",
          "rule_delete",
          "license_update"
        ]
      }
    }
  }
}
