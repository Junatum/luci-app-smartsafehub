{
  "luci-app-smartsafehub": {
    "description": "Grant access to the SmartSafeHub device application",
    "read": {
      "ubus": {
        "smartsafehub": [
          "status",
          "connected_devices",
          "safeshield_rules_list",
          "wifi_summary"
        ],
        "safeshield": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "smartsafehub": [
          "wifi_update",
          "safeshield_set_enabled",
          "safeshield_refresh",
          "safeshield_rule_add",
          "safeshield_rule_delete",
          "system_reboot"
        ]
      }
    }
  }
}
