msgstr "보안 방식"

msgid "I like it"
msgstr "좋음"

msgid "I like it very much"
msgstr "매우 좋음"

msgid "INSTALLED"
msgstr "설치됨"

msgid "IP address"
msgstr "IP 주소"

msgid "If you turn SafeShield protection off, the current blocklist will be removed and DNS blocking will be interrupted immediately. Are you sure you want to continue?"
msgstr "SafeShield 보호를 끄면 현재 차단 목록이 제거되고 DNS 차단이 즉시 중단됩니다. 계속하시겠습니까?"

msgid "In Action"
msgstr "동작 중"

msgid "Inaccessible"
msgstr "확인 불가"

msgid "Internet and Wi-Fi connection interrupted briefly during reboot. If you have any unsaved LuCI settings, please save them first."
msgstr "재부팅하는 동안 인터넷과 Wi-Fi 연결이 잠시 중단됩니다. 저장되지 않은 LuCI 설정이 있다면 먼저 저장해 주세요."

msgid "Invalid command."
msgstr "잘못된 명령입니다."

msgid "JSON-RPC request failed."
msgstr "JSON-RPC 요청에 실패했습니다."

