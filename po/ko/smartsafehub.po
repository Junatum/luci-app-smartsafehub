msgid "Detailed networks, firewalls, packages and logs are managed from the existing LuCI admin screen."
msgstr "상세 네트워크, 방화벽, 패키지와 로그는 기존 LuCI 관리자 화면에서 관리합니다."

msgid "Device API response is empty."
msgstr "장치 API 응답이 비어 있습니다."

msgid "Device API returned HTTP %s error."
msgstr "장치 API가 HTTP %s 오류를 반환했습니다."

msgid "Device Dashboard"
msgstr "장치 대시보드"

msgid "Device List"
msgstr "기기 목록"

msgid "Device disconnected."
msgstr "장치 연결이 끊어졌습니다."

msgid "Device response timed out. Please try again in a moment."
msgstr "장치 응답 시간이 초과되었습니다. 잠시 후 다시 시도해 주세요."

msgid "Device summary"
msgstr "장치 요약"

msgid "Devices connected to wireless APs"
msgstr "무선 AP에 연결된 기기"

msgid "Diagnostic Info"
msgstr "진단 정보"

msgid "Diagnostic information file has been created."
msgstr "진단 정보 파일을 만들었습니다."

msgid "Do you want to reboot the router now?"
msgstr "지금 공유기를 재부팅하시겠습니까?"

msgid "Download diagnostic information"
msgstr "진단 정보 다운로드"

msgid "Easily check the status of devices connected to your wireless network."
msgstr "무선 네트워크와 연결된 기기의 상태를 쉽게 확인합니다."

msgid "Error"
msgstr "오류"

msgid "Execution time could not be determined."
msgstr "실행 시간을 확인할 수 없습니다."

msgid "Failed to change user rules."
msgstr "사용자 규칙을 변경하지 못했습니다."

msgid "Failed to complete system operation."
msgstr "시스템 작업을 완료하지 못했습니다."

msgid "Failed to fetch device status."
msgstr "장치 상태를 불러오지 못했습니다."

msgid "Failed to fetch the list of connected devices."
msgstr "연결된 기기 목록을 불러오지 못했습니다."

msgid "Failed to find default Wi-Fi to manage"
msgstr "관리할 기본 Wi-Fi를 찾지 못했습니다"

msgid "Failed to load SafeShield status."
msgstr "SafeShield 상태를 불러오지 못했습니다."

msgid "Failed to load SmartSafeHub screen."
msgstr "SmartSafeHub 화면을 불러오지 못했습니다."

msgid "Failed to load device status"
msgstr "장치 상태를 불러오지 못했습니다"

msgid "Failed to load system information."
msgstr "시스템 정보를 불러오지 못했습니다."

msgid "Failed to load user rules."
msgstr "사용자 규칙을 불러오지 못했습니다."

msgid "Failed to process SafeShield API request."
msgstr "SafeShield API 요청을 처리하지 못했습니다."

msgid "Failed to process Wi-Fi settings."
msgstr "Wi-Fi 설정을 처리하지 못했습니다."

msgid "Failed to sign in, please verify your account information. Devices with additional authentication enabled can continue under the default LuCI login."
msgstr "로그인하지 못했습니다. 계정 정보를 확인해 주세요. 추가 인증이 설정된 장치는 기본 LuCI 로그인에서 계속할 수 있습니다."

msgid "File Size"
msgstr "파일 크기"

msgid "Firmware uploads, backups, and restores can have a big impact on your device, so use the existing LuCI verification procedures as they are. The SmartSafeHub product screen only provides frequent status checks and secure entry points."
msgstr "펌웨어 업로드, 백업 및 복원은 장치에 큰 영향을 줄 수 있으므로 기존 LuCI의 검증 절차를 그대로 사용합니다. SmartSafeHub 제품 화면은 자주 사용하는 상태 확인과 안전한 진입점만 제공합니다."

msgid "Full Memory"
msgstr "전체 메모리"

msgid "Generating diagnostic information"
msgstr "진단 정보 생성 중"

msgid "HIDDEN"
msgstr "숨김"

msgid "Health check"
msgstr "상태 점검"

msgid "Hide password"
