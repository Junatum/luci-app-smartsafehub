msgstr "비밀번호는 8~63자 또는 64자리 16진수여야 합니다."

msgid "Pause"
msgstr "일시 중지"

msgid "Permissioned Denied!"
msgstr "접근 권한이 없습니다."

msgid "Plan not confirmed"
msgstr "플랜 미확인"

msgid "Please change your search terms or filters."
msgstr "검색어 또는 필터를 변경해 주세요."

msgid "Please check the network identifiers contained in the file before forwarding it to a support agent."
msgstr "지원 담당자에게 전달하기 전에 파일에 포함된 네트워크 식별 정보를 확인해 주세요."

msgid "Please configure the AP mode wireless network in the existing LuCI first."
msgstr "기존 LuCI에서 AP 모드의 무선 네트워크를 먼저 구성해 주세요."

msgid "Please enable JavaScript to use SmartSafeHub."
msgstr "SmartSafeHub를 사용하려면 JavaScript를 활성화해 주세요."

msgid "Please enter SSID between 1 and 32 bytes based on UTF-8."
msgstr "SSID는 UTF-8 기준 1~32바이트로 입력해 주세요."

msgid "Please enter a password that is at least 8 characters"
msgstr "8자 이상의 비밀번호를 입력하세요"

msgid "Please enter your password to use secure Wi-Fi."
msgstr "보안 Wi-Fi를 사용하려면 비밀번호를 입력해 주세요."

msgid "Please enter your username and password."
msgstr "사용자 이름과 비밀번호를 입력해 주세요."

msgid "Please log in with your router management account."
msgstr "공유기 관리 계정으로 로그인해 주세요."

msgid "Prepare for reboot"
msgstr "재부팅 준비"

msgid "Protection off"
msgstr "보호 끄기"

msgid "Quickly manage DNS-based protection and local blocking rules."
msgstr "DNS 기반 보호와 로컬 차단 규칙을 빠르게 관리합니다."

msgid "RELOAD"
msgstr "다시 불러오기"

msgid "RULES"
msgstr "규칙"

msgid "Reboot has started. Please reconnect to the router in a few minutes."
msgstr "재부팅을 시작했습니다. 잠시 후 공유기에 다시 연결해 주세요."

msgid "Reboot now"
msgstr "지금 재부팅"

msgid "Reboot router"
msgstr "공유기 재부팅"

msgid "Recent Devices"
msgstr "최근 기기"

msgid "Recent leases"
msgstr "최근 임대"

msgid "Refresh"
msgstr "새로고침"

msgid "Refresh the current screen"
msgstr "현재 화면 새로고침"

msgid "Refreshing..."
msgstr "새로고침 중"

msgid "Register a domain you want to block yourself, even if it's not in the SafeShield default list."
msgstr "SafeShield 기본 목록에 없더라도 직접 차단할 도메인을 등록합니다."

msgid "Register domains and subdomains that you want to allow even if they are on the blacklist."
msgstr "차단 목록에 포함되어도 허용할 도메인과 하위 도메인을 등록합니다."

msgid "Remove from %s %s"
msgstr "%s %s에서 삭제"

msgid "Renew your blocklist"
msgstr "차단 목록 갱신"

msgid "Requesting reboot"
msgstr "재부팅 요청 중"

msgid "Response Options"
msgstr "보기"

msgid "Rule has already been deleted."
msgstr "이미 삭제된 규칙입니다."

msgid "Rule saving and validation are managed by the SafeShield API. Domains will be normalized to lowercase and duplicates will remain as one."
msgstr "규칙 저장과 유효성 검사는 SafeShield API가 관리합니다. 도메인은 소문자로 정규화되고 중복 항목은 하나로 유지됩니다."

msgid "Rules will be saved, but will not be reflected in DNS until you turn on SafeShield's apply_local_overrides setting."
msgstr "규칙은 저장되지만 SafeShield의 apply_local_overrides 설정을 켜기 전까지 DNS에 반영되지 않습니다."

msgid "SYSTEM STATUS"
msgstr "시스템 상태"

msgid "SafeShield DNS protection is disabled."
msgstr "SafeShield DNS 보호가 비활성화되어 있습니다."

msgid "SafeShield Protection"
msgstr "SafeShield 보호"

msgid "SafeShield Service"
msgstr "SafeShield 서비스"

msgid "SafeShield Status API not found"
msgstr "SafeShield 상태 API를 찾을 수 없습니다"

msgid "SafeShield is disabled"
msgstr "SafeShield가 비활성화되어 있습니다"

msgid "SafeShield is enabled but the service is not running."
msgstr "SafeShield가 활성화되어 있지만 서비스가 실행 중이 아닙니다."

msgid "SafeShield job is paused."
msgstr "SafeShield 작업이 일시 중지되어 있습니다."

msgid "SafeShield operation failed."
msgstr "SafeShield 작업을 수행하지 못했습니다."

msgid "SafeShield protected status"
msgstr "SafeShield 보호 상태"

msgid "SafeShield protection is already active."
msgstr "SafeShield 보호가 이미 활성화 상태입니다."

msgid "SafeShield protection is already inactive."
msgstr "SafeShield 보호가 이미 비활성화 상태입니다."

msgid "Save"
msgstr "저장"

msgid "Save Config"
msgstr "설정 저장"

msgid "Saved the %s %s rule %s. Applying local rules to DNS…"
msgstr "%s %s 규칙 %s를 저장했습니다. 로컬 규칙을 DNS에 적용하고 있습니다…"

msgid "Saved your Wi-Fi settings and reloaded your wireless network."
msgstr "Wi-Fi 설정을 저장하고 무선 네트워크를 다시 불러왔습니다."

