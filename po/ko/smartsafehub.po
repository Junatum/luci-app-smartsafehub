msgstr "OpenWrt의 rpcd API에서 정보를 불러오는 중입니다."

msgid "Local rule enforcement is off"
msgstr "로컬 규칙 적용이 꺼져 있습니다"

msgid "Log out of SmartSafeHub"
msgstr "SmartSafeHub에서 로그아웃"

msgid "Logging in..."
msgstr "로그인 중…"

msgid "Login"
msgstr "로그인"

msgid "Logout"
msgstr "로그아웃"

msgid "LuCI session information not found. Please refresh the page."
msgstr "LuCI 세션 정보를 찾을 수 없습니다. 페이지를 새로고침해 주세요."

msgid "Machine Filters"
msgstr "기기 필터"

msgid "Make your family's internet safer and easier to manage. From protected status to Wi-Fi and connected devices, all in one place."
msgstr "가족의 인터넷을 더 안전하고 간편하게 관리하세요. 보호 상태부터 Wi-Fi와 연결 기기까지 한 곳에서 확인할 수 있습니다."

msgid "Manage SmartSafeHub"
msgstr "SmartSafeHub 관리"

msgid "Manage the domains you want to allow or block."
msgstr "직접 허용하거나 차단할 도메인을 관리합니다."

msgid "Manage the name, security, and usage of your primary wireless network."
msgstr "기본 무선 네트워크의 이름, 보안과 사용 상태를 관리합니다."

msgid "Manage your network with ease"
msgstr "간편한 네트워크 관리"

msgid "Manual renewal runs in the background. Progress is reflected by screen refresh and automatic status check."
msgstr "수동 갱신은 백그라운드에서 실행됩니다. 진행 상태는 화면 새로고침과 자동 상태 확인으로 반영됩니다."

msgid "Memory Usage"
msgstr "메모리 사용"

msgid "Mix WPA2/WPA3"
msgstr "WPA2/WPA3 혼합"

msgid "Mobile Menu Opener"
msgstr "모바일 메뉴 열기"

msgid "Need verification"
msgstr "확인 필요"

msgid "Neutral"
msgstr "보통"

msgid "New Domain"
msgstr "새 도메인"

msgid "New password"
msgstr "새 비밀번호"

msgid "Next Renewal"
msgstr "다음 갱신"

